  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 291700c95e8a22341871cead883b0aa8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  hud: {fileID: 3003524883246342703}
  learningTitle: Aprendizaje
  finishedText: Recorrido completado
  missions:
  - objective: "Misi\xF3n 1: habla con el ciudadano del mercado"
    learning: "Exist\xEDa desigualdad pol\xEDtica y social entre los grupos de la sociedad colonial."
    factTitle: 
    factBody: 
  - objective: "Misi\xF3n 2: investiga el florero con el comerciante"
    learning: "Los criollos buscaban una oportunidad para generar una protesta contra las autoridades espa\xF1olas."
    factTitle: "\xBFSab\xEDas que...?"
    factBody: "Antonio Villavicencio fue una figura importante en el contexto del 20 de julio de 1810. Su recibimiento en Santa Fe fue el motivo que los criollos utilizaron para solicitar el famoso florero a Jos\xE9 Gonz\xE1lez Llorente."
  - objective: "Misi\xF3n 3: ac\xE9rcate a la plaza"
    learning: "El conflicto alrededor del florero desencaden\xF3 una protesta popular el 20 de julio de 1810."
    factTitle: 
    factBody: 
  - objective: "Misi\xF3n 4: habla con los habitantes de la plaza"
    learning: "La protesta impuls\xF3 la organizaci\xF3n de una Junta de Gobierno en Santa Fe."
    factTitle: 
    factBody: 
  - objective: "Misi\xF3n 5: consulta qu\xE9 decisiones se tomaron"
    learning: "El 20 de julio de 1810 marc\xF3 un paso fundamental en el proceso de Independencia, aunque esta no se consigui\xF3 definitivamente ese d\xEDa."
    factTitle: "\xBFSab\xEDas que...?"
    factBody: "\xA1La Independencia no se logr\xF3 en un solo d\xEDa! Despu\xE9s del 20 de julio de 1810, continuaron varios a\xF1os de luchas hasta la Batalla de Boyac\xE1, el 7 de agosto de 1819, que fue decisiva para la independencia de la Nueva Granada."
